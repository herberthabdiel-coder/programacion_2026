#include "celular.h"


celular::celular(std::string usr, std::string psw, int mod, double prc) {
    usuario = usr;
    contraseña = psw;
    modelo = mod;
    presio = prc; 
    encendido = false; 
}

void celular::encender() {
    encendido = true;
    std::cout << "El celular de " << usuario << " se ha encendido.\n";
}

void celular::mostrarInfo() {
    std::cout << "--- Información del Dispositivo ---" << std::endl;
    std::cout << "Usuario: " << usuario << std::endl;
    std::cout << "Modelo (Año): " << modelo << std::endl;
    std::cout << "Precio: $" << presio << std::endl;
    std::cout << "Estado: " << (encendido ? "Encendido" : "Apagado") << std::endl;
    std::cout << "-----------------------------------" << std::endl;
}


void celular::relizarLLamada(std::string numero) {
    if (encendido) {
        std::cout << "Llamando al numero " << numero << "...\n";
    } else {
        std::cout << "Error: El celular esta apagado. No se puede llamar.\n";
    }
}






